# nanocode+ - Git Ignore File
# ============================

# Environment variables and secrets
# .env files are ignored (these contain real secrets)
.env
.env.local
.env.*.local

# But allow example.env to be tracked (template for users)
!example.env

# API keys and sensitive config
*.key
*.pem
secrets/
credentials/

