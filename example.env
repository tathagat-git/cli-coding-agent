# nanocode+ Environment Configuration Example
# =============================================
# Copy this file to .env and fill in your values:
#   cp example.env .env
# 
# Then edit .env with your actual API key and preferences.
# The .env file is gitignored and will NOT be committed.

# OpenRouter API Key (REQUIRED)
# Get your key at: https://openrouter.ai
OPENROUTER_API_KEY=your-api-key-here

# OpenRouter Base URL (usually no need to change)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default Model (can be overridden via CLI --model flag)
DEFAULT_MODEL=poolside/laguna-s-2.1:free

# Workspace directory for generated files
WORKSPACE_DIR=.workspace

# Auto-approve tool calls without confirmation (be careful with this!)
# Set to "true" to automatically approve, "false" to prompt for each action
AUTO_APPROVE=false

# Auto-run tests after code generation
# Set to "true" to enable, "false" to disable
AUTO_TEST=true

# Maximum README file size in characters
MAX_README_SIZE=5000

# Maximum iterations per task
MAX_ITERATIONS=50

# Default temperature for LLM (0.0 = deterministic, 1.0 = creative)
TEMPERATURE=0.7